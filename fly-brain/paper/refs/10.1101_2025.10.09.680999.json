{"status":"ok","message-type":"work","message-version":"1.0.0","message":{"institution":[{"name":"bioRxiv"}],"indexed":{"date-parts":[[2026,10,10]],"date-time":"2026-10-10T01:58:11Z","timestamp":1791597491788,"version":"4.3.4"},"posted":{"date-parts":[[2025,10,9]]},"group-title":"Neuroscience","reference-count":0,"publisher":"openRxiv","license":[{"start":{"date-parts":[[2025,10,9]],"date-time":"2025-10-09T00:00:00Z","timestamp":1759968000000},"content-version":"vor","delay-in-days":0,"URL":"http:\/\/creativecommons.org\/licenses\/by\/4.0\/"}],"funder":[{"award":["220343\/Z\/20\/Z"],"award-info":[{"award-number":["220343\/Z\/20\/Z"]}],"id":[{"id":"https:\/\/ror.org\/029chgv08","id-type":"ROR","asserted-by":"publisher"}]},{"award":["221300\/Z\/20\/Z"],"award-info":[{"award-number":["221300\/Z\/20\/Z"]}],"id":[{"id":"https:\/\/ror.org\/029chgv08","id-type":"ROR","asserted-by":"publisher"}]},{"id":[{"id":"https:\/\/ror.org\/006w34k90","id-type":"ROR","asserted-by":"publisher"}]},{"id":[{"id":"https:\/\/ror.org\/00tw3jy02","id-type":"ROR","asserted-by":"publisher"}]}],"content-domain":{"domain":[],"crossmark-restriction":false},"short-container-title":[],"accepted":{"date-parts":[[2025,10,30]]},"abstract":"<jats:p>\n                  Sex differences in behaviour exist across all animals, typically under strong genetic regulation. In\n                  <jats:italic>Drosophila<\/jats:italic>\n                  ,\n                  <jats:italic>fruitless<\/jats:italic>\n                  \/\n                  <jats:italic>doublesex<\/jats:italic>\n                  transcription factors can identify dimorphic neurons but their organisation into functional circuits remains unclear. We present the connectome of the entire\n                  <jats:italic>Drosophila<\/jats:italic>\n                  male central nervous system. This contains 166,691 neurons spanning the brain and nerve cord, fully proofread and annotated including\n                  <jats:italic>fruitless<\/jats:italic>\n                  \/\n                  <jats:italic>doublesex<\/jats:italic>\n                  expression and 11,691 types. We provide the first comprehensive comparison between male and female brain connectomes to synaptic resolution, finding 7,205 isomorphic, 114 dimorphic, 262 male-specific and 69 female-specific types. This resource enables analysis of full sensory-to-motor circuits underlying complex behaviours and the impact of dimorphic elements. Sex-specific\/dimorphic neurons are concentrated in higher brain centres while the sensory and motor periphery are largely isomorphic. Within higher centres, male-specific connections are organised into hotspots defined by male-specific neurons or arbours. Numerous circuit switches reroute sensory information to form antagonistic circuits controlling opposing behaviours.\n                <\/jats:p>","DOI":"10.1101\/2025.10.09.680999","type":"posted-content","created":{"date-parts":[[2025,10,9]],"date-time":"2025-10-09T17:55:18Z","timestamp":1760032518000},"source":"Crossref","is-referenced-by-count":54,"title":["Sexual dimorphism in the complete connectome of the\n                  <i>Drosophila<\/i>\n                  male central nervous system"],"prefix":"10.64898","author":[{"ORCID":"https:\/\/orcid.org\/0000-0002-0766-0488","authenticated-orcid":false,"given":"Stuart","family":"Berg","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0009-0001-3527-6782","authenticated-orcid":false,"given":"Isabella R","family":"Beckett","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0000-0001-5948-3092","authenticated-orcid":false,"given":"Marta","family":"Costa","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"ORCID":"https:\/\/orcid.org\/0000-0002-5633-1314","authenticated-orcid":false,"given":"Philipp","family":"Schlegel","